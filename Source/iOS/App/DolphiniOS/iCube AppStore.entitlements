<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- gc-emu: Iridia App Store entitlements. Only what the app uses:
     - increased-memory-limit: Twilight Princess peaks ~1.4 GB at 8x internal resolution (BENCHMARKS #12);
       4 GB phones need the higher ceiling. Request it on the App ID in Phase 9.
     - extended-virtual-addressing: Dolphin reserves a large virtual range for the emulated memory map
       (data only; no executable memory).
     - App Group: settings/library snapshot shared with the Top Shelf / Live Activity extensions.
     No JIT or executable-memory keys (scripts/verify_no_jit.sh), no microphone, no photo library. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.iridia</string>
	</array>
</dict>
</plist>
